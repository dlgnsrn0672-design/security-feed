TELEGRAM_TOKEN=여기에_봇_토큰
TELEGRAM_CHAT_ID=여기에_채팅_ID

# 선택: https://nvd.nist.gov/developers/request-an-api-key (요청 한도 증가)
NVD_API_KEY=
# 선택: 번역용 DeepL 키. 비워두면 영어 원문
DEEPL_API_KEY=

# 이 점수 이상이면 알림 (9.0 = Critical 등급 전체)
MIN_CVSS_SCORE=9.0
POLL_MINUTES=15
FIRST_RUN_LOOKBACK_HOURS=24
MAX_CVE_AGE_DAYS=30
KEV_FIRST_RUN_DAYS=3
FEED_FIRST_RUN_SHOW=3
FORCE_IPV4=1
